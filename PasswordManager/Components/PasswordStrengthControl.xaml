<UserControl x:Class="PasswordManager.Components.PasswordStrengthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PasswordManager.Components"
             mc:Ignorable="d" 
           Height="50" Width="300">

    <StackPanel Orientation="Vertical" Margin="5">

        <ProgressBar x:Name="StrengthBar" Height="10" Maximum="100" Minimum="0" Margin="0,5" />

        <TextBlock x:Name="StrengthText" 
                   HorizontalAlignment="Left" 
                   Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
